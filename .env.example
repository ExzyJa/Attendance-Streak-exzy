DISCORD_TOKEN=your-bot-token-here

CLIENT_ID=your-application-client-id-here 

# Required for web-based moderator setup.
# Register this exact callback URL in Discord Developer Portal -> OAuth2.
DISCORD_CLIENT_ID=your-application-client-id-here
DISCORD_CLIENT_SECRET=your-oauth2-client-secret-here
DISCORD_REDIRECT_URI=https://your-railway-domain.up.railway.app/auth/callback


# Optional. Leave unset for local/VPS use (writes attendance.sqlite next to the code).
# On Railway, set this to a path inside your mounted volume, e.g. /data/attendance.sqlite,
# so streak data survives redeploys and restarts.
DB_PATH=
